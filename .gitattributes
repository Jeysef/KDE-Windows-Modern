# Treat the icon pack as binary-ish: do not produce text diffs.
# This keeps `git diff` and status operations fast.
icons/** -diff

# Left out of `git archive` (the GitHub release bundle built by
# scripts/package.sh): README screenshots and maintainer-only material.
/View-*.png export-ignore
/plans export-ignore
/AGENTS.md export-ignore
/CLAUDE.md export-ignore
/tests export-ignore
/.github export-ignore
/scripts/release.sh export-ignore
/scripts/commit-icons.sh export-ignore
/scripts/capture-screenshots.sh export-ignore
/scripts/update-previews.sh export-ignore
/scripts/store export-ignore
