+        // Windows Modern: load the Windows-style login theme when installed,
+        // else the built-in one. A real login uses the system-wide copy; --test
+        // prefers the user's copy, so theme changes can be tried without root.
+        QString systemThemePath = QStringLiteral("/usr/share/plasma/look-and-feel/org.kde.windowsmodern.dark"
