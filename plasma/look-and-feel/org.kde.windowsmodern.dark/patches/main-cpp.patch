+        QString userThemePath = QDir::homePath()
+            + QStringLiteral("/.local/share/plasma/look-and-feel/org.kde.windowsmodern.dark"
+                             "/contents/lockscreen/Main.qml");
+        if (s_testMode && QFile::exists(userThemePath)) {
+            window->setSource(QUrl::fromLocalFile(userThemePath));
+        } else if (QFile::exists(systemThemePath)) {
+            window->setSource(QUrl::fromLocalFile(systemThemePath));
+        } else if (QFile::exists(userThemePath)) {
+            window->setSource(QUrl::fromLocalFile(userThemePath));
+        } else {
+            window->setSource(QUrl(QStringLiteral("qrc:/qt/qml/org/kde/plasma/login/Main.qml")));
+        }
         window->show();
     }
 
